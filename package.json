{
  "name": "bubble-io-visual-tester",
  "version": "1.1.0",
  "description": "Visual regression testing CLI for Bubble.io applications — pixel-perfect screenshot diffing across viewports and browsers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bubble-tester": "./dist/index.js"
  },
  "files": [
    "dist/",
    "visual.config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx src/index.ts",
    "clean:dist": "node -e \"const fs=require('fs');const p='dist';if(fs.existsSync(p))fs.rmSync(p,{recursive:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bubble",
    "bubble.io",
    "visual-testing",
    "visual-regression",
    "playwright",
    "screenshot",
    "diffing",
    "ui-testing",
    "cli"
  ],
  "author": "Alexandr Motologa",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrmotologa/bubble-io-visual-tester.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.44.1",
    "pngjs": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pngjs": "^6.0.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
