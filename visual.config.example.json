{
  "appUrlTest": "https://myapp.bubbleapps.io/version-test",
  "appUrlLive": "https://myapp.bubbleapps.io",
  "browsers": ["chromium"],
  "viewports": [
    { "name": "desktop", "width": 1920, "height": 1080 },
    { "name": "tablet",  "width": 768,  "height": 1024 },
    { "name": "mobile",  "width": 375,  "height": 812  }
  ],
  "pages": [
    { "path": "/", "name": "Home" },
    { "path": "/login", "name": "Login Page" },
    {
      "path": "/dashboard",
      "name": "User Dashboard",
      "waitForSelector": ".dashboard-loaded",
      "waitForTimeout": 2000
    }
  ],
  "auth": {
    "enabled": false,
    "loginUrl": "https://example.com/login",
    "storageStatePath": "./auth.json",
    "autoLogin": {
      "username": "admin@example.com",
      "password": "secretpassword",
      "usernameSelector": "input[type='email']",
      "passwordSelector": "input[type='password']",
      "submitSelector": "button[type='submit']"
    }
  },
  "notifications": {
    "webhookUrl": "https://hooks.slack.com/services/...",
    "onFailureOnly": true
  },
  "options": {
    "threshold": 0.1,
    "maskSelectors": [".dynamic-timestamp", ".user-avatar", ".realtime-chart"],
    "ignoreRegions": [
      { "x": 100, "y": 200, "width": 300, "height": 50, "page": "Home" }
    ],
    "failOnMismatch": true,
    "fullPage": false,
    "concurrency": 3
  }
}
